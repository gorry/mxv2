<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	android:installLocation="auto">

	<!-- SDL の描画は OpenGL ES 2.0。 -->
	<uses-feature android:glEsVersion="0x00020000" />

	<!-- タッチもマウスも無くても構わない（物理キーボードでも操作できる）。 -->
	<uses-feature
		android:name="android.hardware.touchscreen"
		android:required="false" />
	<uses-feature
		android:name="android.hardware.type.pc"
		android:required="false" />

	<!-- バックグラウンドでも演奏を続けるための前面サービス（PlaybackService）。
	     FOREGROUND_SERVICE_MEDIA_PLAYBACK は Android 14 以降で、
	     foregroundServiceType="mediaPlayback" を名乗るのに要る。 -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
	<!-- 演奏中の通知。Android 13 以降は実行時にも尋ねる（MainActivity）。 -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<!-- 画面が消えてもデコードスレッドを回し続ける。 -->
	<uses-permission android:name="android.permission.WAKE_LOCK" />
	<!-- 更新チェック（GitHub Releases API を 1 日 1 回。src/updatecheck.cpp）。
	     [mxv2 の設定] の [通信] で止められる。 -->
	<uses-permission android:name="android.permission.INTERNET" />

	<application android:label="@string/app_name"
		android:icon="@mipmap/ic_launcher"
		android:allowBackup="true"
		android:theme="@style/AppTheme"
		android:hardwareAccelerated="true">

		<activity android:name=".MainActivity"
			android:label="@string/app_name"
			android:alwaysRetainTaskState="true"
			android:launchMode="singleInstance"
			android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
			android:preferMinimalPostProcessing="true"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>

			<!-- ファイルマネージャなどで *.mdx を叩いたとき。開く手順は
			     src/openintent.cpp と OpenIntentBridge.java にある。

			     **MDX に登録された MIME 型は無い**ので、見分けるのは
			     パスの末尾だけ。提供元が名乗る型はまちまち
			     (application/octet-stream / audio/* / 何も名乗らない) なので、
			     型のほうは "*/*" で全部受ける。

			     **pathPattern の ".*" は後戻りしない**実装（PatternMatcher の
			     PATTERN_SIMPLE_GLOB）なので、途中に '.' があると ".*\\.mdx"
			     では合わない。ドットの数だけ並べるのが Android の定番。
			     pathSuffix は Android 12 (API 31) 以降でだけ効く（古い端末は
			     知らない属性として読み飛ばす）。

			     大文字小文字は区別されるので、.mdx と .MDX の両方を書く。 -->
			<intent-filter android:label="@string/app_name">
				<action android:name="android.intent.action.VIEW" />
				<category android:name="android.intent.category.DEFAULT" />
				<category android:name="android.intent.category.BROWSABLE" />
				<data android:scheme="content" />
				<data android:scheme="file" />
				<data android:host="*" />
				<data android:mimeType="*/*" />
				<data android:pathSuffix=".mdx" />
				<data android:pathSuffix=".MDX" />
				<data android:pathPattern=".*\\.mdx" />
				<data android:pathPattern=".*\\..*\\.mdx" />
				<data android:pathPattern=".*\\..*\\..*\\.mdx" />
				<data android:pathPattern=".*\\..*\\..*\\..*\\.mdx" />
				<data android:pathPattern=".*\\.MDX" />
				<data android:pathPattern=".*\\..*\\.MDX" />
				<data android:pathPattern=".*\\..*\\..*\\.MDX" />
				<data android:pathPattern=".*\\..*\\..*\\..*\\.MDX" />
			</intent-filter>

			<!-- 型を名乗らずに渡されたとき。**mimeType を書いたフィルタは
			     型が null だと一致しない**ので、別に用意する（file:// で
			     渡してくるものがこれ）。 -->
			<intent-filter android:label="@string/app_name">
				<action android:name="android.intent.action.VIEW" />
				<category android:name="android.intent.category.DEFAULT" />
				<category android:name="android.intent.category.BROWSABLE" />
				<data android:scheme="content" />
				<data android:scheme="file" />
				<data android:host="*" />
				<data android:pathSuffix=".mdx" />
				<data android:pathSuffix=".MDX" />
				<data android:pathPattern=".*\\.mdx" />
				<data android:pathPattern=".*\\..*\\.mdx" />
				<data android:pathPattern=".*\\..*\\..*\\.mdx" />
				<data android:pathPattern=".*\\..*\\..*\\..*\\.mdx" />
				<data android:pathPattern=".*\\.MDX" />
				<data android:pathPattern=".*\\..*\\.MDX" />
				<data android:pathPattern=".*\\..*\\..*\\.MDX" />
				<data android:pathPattern=".*\\..*\\..*\\..*\\.MDX" />
			</intent-filter>
		</activity>

		<!-- 演奏中の通知。実体は PlaybackService、窓口は PlaybackBridge。
		     アプリの中からしか起こさないので exported は false。 -->
		<service android:name=".PlaybackService"
			android:exported="false"
			android:foregroundServiceType="mediaPlayback" />
	</application>

</manifest>
